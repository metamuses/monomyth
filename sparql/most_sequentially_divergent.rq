# Title:    Most sequentially divergent stage
# Question: Which monomyth stage exhibits the most sequential divergences across its realizations?
# Output:   stage class, stage name, number of realizations, number of
#           sequential divergences, average sequential divergences per
#           realization

PREFIX monomyth: <https://monomyth.metamuses.org/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?stage ?stageLabel
       (COUNT(DISTINCT ?realization) AS ?realizationCount)
       (COUNT(DISTINCT ?sequentialDivergence) AS ?sequentialDivergenceCount)
       ((COUNT(DISTINCT ?sequentialDivergence) * 1.0) / COUNT(DISTINCT ?realization) AS ?avgSequentialDivergencesPerRealization)
WHERE {
  ?stage a monomyth:Stage ;
         rdfs:label ?stageLabel .

  ?realization a monomyth:StageRealization ;
               monomyth:realizesStage ?stage .

  OPTIONAL {
    ?realization monomyth:hasSequentialDivergence ?sequentialDivergence .
  }
}
GROUP BY ?stage ?stageLabel
ORDER BY DESC(?avgSequentialDivergencesPerRealization) DESC(?sequentialDivergenceCount)
LIMIT 1
