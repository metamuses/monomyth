# Title:    Most semiotically divergent stage
# Question: Which monomyth stage exhibits the most semiotic divergences across
#           its realizations?
# Output:   stage class, stage name, number of realizations, number of semiotic
#           divergences, average semiotic divergences per realization

PREFIX monomyth: <https://monomyth.metamuses.org/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?stage ?stageLabel
       (COUNT(DISTINCT ?realization) AS ?realizationCount)
       (COUNT(DISTINCT ?semioticDivergence) AS ?semioticDivergenceCount)
       ((COUNT(DISTINCT ?semioticDivergence) * 1.0) / COUNT(DISTINCT ?realization) AS ?avgSemioticDivergencesPerRealization)
WHERE {
  ?stage a monomyth:Stage ;
         rdfs:label ?stageLabel .

  ?realization a monomyth:StageRealization ;
               monomyth:realizesStage ?stage .

  OPTIONAL {
    ?realization monomyth:hasSemioticDivergence ?semioticDivergence .
  }
}
GROUP BY ?stage ?stageLabel
ORDER BY DESC(?avgSemioticDivergencesPerRealization) DESC(?semioticDivergenceCount)
LIMIT 1
